# =================================================================
# TASK 1/2: Henter valutakurser fra Norges Bank → landing-sonen
# Neste task (DLT-pipelinen) leser landing-sonen og skriver til bronse.
# =================================================================

import requests
import json
from datetime import date, datetime, timedelta


# -----------------------------------------------------------------
# DEL 1: PARAMETERE
# -----------------------------------------------------------------

# Bruker dropdown slik at lastetype kan velges manuelt ved behov.
# Default er "full" — trygt for første kjøring.
dbutils.widgets.dropdown(
    "lastetype", "full", ["auto", "inkrementell", "full"], "Lastetype"
)
LASTETYPE_PARAMETER = dbutils.widgets.get("lastetype").strip().lower()

# Feiler tidlig — ugyldig verdi skal ikke komme gjennom til extract.
if LASTETYPE_PARAMETER not in ("auto", "inkrementell", "full"):
    raise ValueError(
        f"Ugyldig lastetype: '{LASTETYPE_PARAMETER}'. "
        "Må være 'auto', 'inkrementell' eller 'full'."
    )

print(f"ℹ️ Parameter 'lastetype' satt til: '{LASTETYPE_PARAMETER}'")

# Kommaseparert liste — gjør det enkelt å legge til nye valutaer uten kodeendring.
dbutils.widgets.text("valutaer", "EUR,SEK,USD", "Valutaer (kommaseparert)")
VALUTAER_PARAMETER = dbutils.widgets.get("valutaer").strip()
VALUTAER = [v.strip().upper() for v in VALUTAER_PARAMETER.split(",") if v.strip()]

if not VALUTAER:
    raise ValueError(
        f"Ugyldig parameter 'valutaer': '{VALUTAER_PARAMETER}'. "
        "Må være en kommaseparert liste, f.eks. 'EUR,SEK,USD'."
    )

# Brukes kun ved full last — angir hvor langt tilbake vi henter historikk.
dbutils.widgets.text("full_start_periode", "2026-01-01", "Full last - startdato")
FULL_START_PERIODE = dbutils.widgets.get("full_start_periode").strip()

try:
    datetime.strptime(FULL_START_PERIODE, "%Y-%m-%d")
except ValueError:
    raise ValueError(
        f"Ugyldig parameter 'full_start_periode': '{FULL_START_PERIODE}'. "
        "Må være på format 'YYYY-MM-DD', f.eks. '2026-01-01'."
    )

# Katalog-parameteren gjør notebooken miljø-agnostisk (dev/test/prod).
dbutils.widgets.text("katalog", "test_dab", "Katalog (Unity Catalog)")
KATALOG = dbutils.widgets.get("katalog").strip()

print(f"ℹ️ Valutaer:           {VALUTAER}")
print(f"ℹ️ Full start-periode: '{FULL_START_PERIODE}'")
print(f"ℹ️ Katalog:            '{KATALOG}'")


# -----------------------------------------------------------------
# DEL 2: KONFIGURASJON
# -----------------------------------------------------------------

LANDING_SKJEMA = "landing"
LANDING_VOLUM  = "valuta"
BRONSE_SKJEMA  = "dlt_bronse"
BRONSE_TABELL  = "valutakurs"

# Filer landes her — DLT-pipelinen leser fra denne stien via Auto Loader.
LANDING_PATH = f"/Volumes/{KATALOG}/{LANDING_SKJEMA}/{LANDING_VOLUM}"

# Brukes kun i DEL 4 for å detektere om tabellen finnes (auto-modus).
# Selve skrivingen til tabellen eies av DLT — ikke denne notebooken.
TABELLNAVN = f"{KATALOG}.{BRONSE_SKJEMA}.{BRONSE_TABELL}"

print(f"LANDING_PATH: {LANDING_PATH}")
print(f"TABELLNAVN:   {TABELLNAVN}  (eies av DLT-pipelinen)")


# -----------------------------------------------------------------
# DEL 3: INFRASTRUKTURSJEKK
# -----------------------------------------------------------------

# Idempotente SQL-kall — trygge å kjøre gjentatte ganger.
# dlt_bronse-skjemaet opprettes av DLT selv — opprettes bevisst ikke her.
spark.sql(f"CREATE SCHEMA IF NOT EXISTS {KATALOG}.{LANDING_SKJEMA}")
spark.sql(f"CREATE VOLUME IF NOT EXISTS {KATALOG}.{LANDING_SKJEMA}.{LANDING_VOLUM}")
dbutils.fs.mkdirs(LANDING_PATH)

print("✅ Skjema og volum verifisert/opprettet.")


# -----------------------------------------------------------------
# DEL 4: BESTEM LASTETYPE
# -----------------------------------------------------------------

if LASTETYPE_PARAMETER in ("inkrementell", "full"):
    # Eksplisitt valgt — ingen deteksjon nødvendig.
    LASTETYPE = LASTETYPE_PARAMETER
    print(f"ℹ️ Lastetype eksplisitt satt -> '{LASTETYPE.upper()}'.")

else:  # "auto" — detekter basert på tilstanden til bronse-tabellen.
    tabell_finnes = spark.catalog.tableExists(TABELLNAVN)

    if not tabell_finnes:
        # Tabellen eksisterer ikke ennå — DLT oppretter den på første kjøring.
        LASTETYPE = "full"
        print(f"ℹ️ [auto] Tabellen finnes ikke -> FULL LAST.")
    else:
        antall_rader = spark.table(TABELLNAVN).limit(1).count()
        if antall_rader == 0:
            # Tabellen er opprettet men tom — kjør full last for å fylle den.
            LASTETYPE = "full"
            print(f"ℹ️ [auto] Tabellen er tom -> FULL LAST.")
        else:
            # Tabellen har data — hent kun det som mangler.
            LASTETYPE = "inkrementell"
            print(f"ℹ️ [auto] Tabellen har data -> INKREMENTELL LAST.")


# -----------------------------------------------------------------
# DEL 5: EXTRACT — hent fra Norges Bank API → landing-sonen
# -----------------------------------------------------------------

if LASTETYPE == "full":
    # Full last: hent alt fra fast startdato frem til i dag.
    START_PERIODE = FULL_START_PERIODE
    print(f"ℹ️ Full last fra: {START_PERIODE}.")

else:
    # Inkrementell: finn siste fil i landing-sonen og hent fra dagen etter.
    # Filnavn-konvensjon: valutakurser_{lastetype}_{DATO}_{timestamp}.json
    eksisterende_filer = [f.name for f in dbutils.fs.ls(LANDING_PATH)] \
        if any(True for _ in dbutils.fs.ls(LANDING_PATH)) else []

    siste_dato = None
    for filnavn in eksisterende_filer:
        try:
            # Datoer sitter på indeks 2 etter split på "_".
            dato_del = filnavn.split("_")[2]
            fil_dato = datetime.strptime(dato_del, "%Y-%m-%d").date()
            if siste_dato is None or fil_dato > siste_dato:
                siste_dato = fil_dato
        except (IndexError, ValueError):
            # Hopp over filer som ikke følger navnekonvensjonen.
            continue

    if siste_dato is None:
        # Ingen gyldige filer funnet — fall tilbake til full startdato.
        START_PERIODE = FULL_START_PERIODE
        print(f"ℹ️ Ingen tidligere filer funnet. Bruker startdato {START_PERIODE}.")
    else:
        # Hent fra dagen etter siste kjente dato.
        START_PERIODE = str(siste_dato + timedelta(days=1))
        print(f"ℹ️ Siste dato: {siste_dato}. Henter fra: {START_PERIODE}.")

SLUTT_PERIODE = str(date.today())

# Ingen nye perioder å hente — dette er normalt på helger og helligdager.
HOPP_OVER_EXTRACT = START_PERIODE > SLUTT_PERIODE
if HOPP_OVER_EXTRACT:
    print(f"✅ Ingen nye perioder (start {START_PERIODE} > slutt {SLUTT_PERIODE}).")

if not HOPP_OVER_EXTRACT:
    # Bygg URL — "+" kombinerer flere valutaer i ett API-kall.
    valuta_str = "+".join(VALUTAER)
    url = f"https://data.norges-bank.no/api/data/EXR/B.{valuta_str}.NOK.SP"
    params = {
        "startPeriod": START_PERIODE,
        "endPeriod":   SLUTT_PERIODE,
        "format":      "sdmx-json",
        "locale":      "no",
    }
    response = requests.get(url, params=params)
    print("Hentet URL:", response.url)

    if response.status_code == 404:
        # 404 = ingen data for perioden (helg/helligdag) — ikke en feil.
        print("✅ Ingen data for perioden (404 — helg/helligdag).")
        HOPP_OVER_EXTRACT = True
    else:
        response.raise_for_status()
        data = response.json()
        antall_serier = len(
            data.get("data", {}).get("dataSets", [{}])[0].get("series", {})
        )
        print(f"Antall serier i respons: {antall_serier}")

        if antall_serier == 0:
            if LASTETYPE == "full":
                # Ingen data på full last er uventet — sannsynlig feilkonfigurasjon.
                raise ValueError(
                    f"Ingen data for full last, periode {START_PERIODE}–{SLUTT_PERIODE}. "
                    "Sjekk VALUTAER og START_PERIODE."
                )
            else:
                # Ingen nye observasjoner på inkrementell — normalt for korte perioder.
                print("✅ Ingen nye observasjoner i perioden.")
                HOPP_OVER_EXTRACT = True

if not HOPP_OVER_EXTRACT:
    # Timestamp i filnavnet sikrer unikhet selv ved gjenkjøring samme dag.
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    filnavn = f"valutakurser_{LASTETYPE}_{SLUTT_PERIODE}_{timestamp}.json"
    filsti  = f"{LANDING_PATH}/{filnavn}"

    # overwrite=False: feiler eksplisitt ved navnekollisjon (svært usannsynlig).
    dbutils.fs.put(filsti, json.dumps(data, ensure_ascii=False), overwrite=False)
    print(f"✅ Lagret rådata til: {filsti}")
else:
    print("ℹ️ Ingen ny fil produsert denne kjøringen.")

print(f"\nEXTRACT FULLFØRT — lastetype: {LASTETYPE.upper()}")
print(f"Neste task: DLT-pipelinen leser {LANDING_PATH} → {TABELLNAVN}")

